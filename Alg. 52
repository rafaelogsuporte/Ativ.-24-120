import kotlin.math.sqrt

fun main() {
    print("\nDigite o lado do quadrado: ")
    val lado = readln().toDouble()

    val perimetro = 4 * lado
    val area = lado * lado
    val diagonal = lado * sqrt(2.0)

    println("\nPerímetro: $perimetro")
    println("Área: $area")
    println("Diagonal: $diagonal")
    println()
}
