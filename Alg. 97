fun main() {
    print("\nDigite um número: ")
    val numero = readln().toInt()

    if (numero % 10 == 0) {
        println("\nMúltiplo de 10")
    } else {
        if (numero % 2 == 0) {
            println("\nMúltiplo de 2")
        } else {
            if (numero % 5 == 0) {
                println("\nMúltiplo de 5")
            } else {
                println("\nNão é múltiplo de 2 nem de 5")
            }
        }
    }

    println()
}
