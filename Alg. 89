fun main() {
    println("Planetas que podem ser analisados:")
    println("1 - Mercúrio")
    println("2 - Vênus")
    println("3 - Marte")
    println("4 - Júpiter")
    println("5 - Saturno")
    println("6 - Urano")

    print("\nEscolha o planeta a ser analisado: ")
    val op = readln().toInt()

    print("Entre com seu peso na Terra (em kg): ")
    val pterra = readln().toDouble()

    when (op) {
        1 -> println("Seu peso em Mercúrio é: %.2f kg".format((pterra / 10) * 0.37))
        2 -> println("Seu peso em Vênus é: %.2f kg".format((pterra / 10) * 0.88))
        3 -> println("Seu peso em Marte é: %.2f kg".format((pterra / 10) * 0.38))
        4 -> println("Seu peso em Júpiter é: %.2f kg".format((pterra / 10) * 2.64))
        5 -> println("Seu peso em Saturno é: %.2f kg".format((pterra / 10) * 1.15))
        6 -> println("Seu peso em Urano é: %.2f kg".format((pterra / 10) * 1.17))
        else -> println("Este planeta não pode ser analisado.")
    }

    println()
}
