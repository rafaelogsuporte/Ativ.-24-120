fun main() {
    print("\nDigite o 1º número: ")
    val a = readln().toDouble()

    print("\nDigite o 2º número: ")
    val b = readln().toDouble()

    val d = (a - b) * (a - b)
    val q = (a * a) - (b * b)

    println("\nO quadrado da diferença = $d")
    println("Diferença dos quadrados = $q")
    println()
}
